# Copy this file to .env and fill in values before running.
# The app works with all defaults for local development.

# Secret key for signed session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production

# Database URL (SQLite default; leave as-is for local dev)
DATABASE_URL=sqlite:///./concave_tickets.db

# App environment
APP_ENV=development

# Log level
LOG_LEVEL=INFO
